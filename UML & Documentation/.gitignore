# ===================================
# Cybercrime Tracker - .gitignore
# ===================================

# PlantUML generated files
output/
*.png
*.svg
*.pdf
*.eps
plantuml.jar

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# MongoDB
data/
dump/
*.mongo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Build outputs
dist/
build/
out/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

# Coverage
coverage/
.nyc_output/

# Documentation builds (keep source .md files)
docs/build/

# Private keys and certificates
*.key
*.pem
*.cert
*.crt

# Database backups
*.dump
backup/

# API keys and secrets (NEVER commit these!)
config/secrets.js
config/api-keys.json

# Test files
test-results/
*.test.local.*

